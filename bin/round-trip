#!/usr/bin/env bash
# Round-trip gate:
#
#   bin/round-trip [FIXTURE [NAME]]
#
#   FIXTURE -> PostgreSQL -> pg_dump -Fc -> pull ->
#   load + validate -> build -> pg_restore -> pg_dump --schema-only
#   of both databases -> diff is empty
#
# Plus a second restore with ownership applied, which the comparing
# restore cannot check because it runs --no-owner, a round trip of the
# settings and the comments of a role and a user, and of a tablespace,
# which pull reads from pg_dumpall, a restore of a built project with
# objects that its roles own, and a restore of a built project with
# text that is not ASCII into a LATIN1 and a UTF8 database.
#
# Requires a PostgreSQL superuser connection (defaults target the
# compose.yaml container; override with PGHOST/PGPORT/PGUSER) and the
# postgres client tools on PATH. All commands run via psql/pg_dump
# against scratch databases, named NAME_source, NAME_restored,
# NAME_owned, NAME_roles, NAME_enc_latin1 and NAME_enc_utf8, that are
# dropped and recreated. FIXTURE defaults to fixtures/schema.sql and
# NAME to roundtrip.
#
# pull formats routine bodies, so a fixture that is not written in the
# formatter's style dumps its bodies differently after the round trip.
# NORMALIZE_BODIES=1 compares the bodies with whitespace and semicolons
# removed (bin/normalize-routine-bodies); everything else is compared
# exactly. fixtures/schema.sql is written in that style and needs no
# normalizing.
set -euo pipefail

FIXTURE="${1:-fixtures/schema.sql}"
NAME="${2:-roundtrip}"

PGHOST="${PGHOST:-localhost}"
PGPORT="${PGPORT:-5432}"
PGUSER="${PGUSER:-postgres}"
export PGHOST PGPORT PGUSER

SOURCE_DB="${NAME}_source"
RESTORED_DB="${NAME}_restored"
OWNED_DB="${NAME}_owned"
SETTINGS_ROLE="${NAME}_settings"
SETTINGS_USER="${NAME} Settings User"
TABLESPACE="${NAME} Space"
TABLESPACE_OWNER="${NAME} Space Owner"
TABLESPACE_USER="${NAME}_space_user"
ROLES_DB="${NAME}_roles"
ROLES_OWNER="${NAME} Owner"
ROLES_USER="${NAME}_reader"
ROLES_GROUP="${NAME}_readers"
ENC_DB_PREFIX="${NAME}_enc"
WORKDIR="$(mktemp -d)"

drop_settings_roles() {
    psql -d postgres -q -v ON_ERROR_STOP=1 \
        -c "DROP ROLE IF EXISTS \"${SETTINGS_ROLE}\"" \
        -c "DROP ROLE IF EXISTS \"${SETTINGS_USER}\""
}

drop_project_roles() {
    psql -d postgres -q -v ON_ERROR_STOP=1 \
        -c "DROP ROLE IF EXISTS \"${ROLES_OWNER}\"" \
        -c "DROP ROLE IF EXISTS \"${ROLES_USER}\"" \
        -c "DROP ROLE IF EXISTS \"${ROLES_GROUP}\""
}

drop_tablespace() {
    psql -d postgres -q -v ON_ERROR_STOP=1 \
        -c "DROP TABLESPACE IF EXISTS \"${TABLESPACE}\"" \
        -c "DROP ROLE IF EXISTS \"${TABLESPACE_OWNER}\"" \
        -c "DROP ROLE IF EXISTS \"${TABLESPACE_USER}\""
}

cleanup() {
    rm -rf "$WORKDIR"
    drop_settings_roles >/dev/null 2>&1 || true
    drop_tablespace >/dev/null 2>&1 || true
    bin/drop-database "${ROLES_DB}" >/dev/null 2>&1 || true
    drop_project_roles >/dev/null 2>&1 || true
    bin/drop-database "${RESTORED_DB}" \
        >/dev/null 2>&1 || true
    bin/drop-database "${OWNED_DB}" \
        >/dev/null 2>&1 || true
    bin/drop-database "${SOURCE_DB}" \
        >/dev/null 2>&1 || true
    for db in "${ENC_DB_PREFIX}_latin1" "${ENC_DB_PREFIX}_utf8"; do
        bin/drop-database "${db}" >/dev/null 2>&1 || true
    done
}

trap cleanup EXIT INT TERM

echo "==> Building pglifecycle"
cargo build --quiet

echo "==> Creating ${SOURCE_DB} from ${FIXTURE}"
bin/drop-database "${SOURCE_DB}"
psql -d postgres -q -c "CREATE DATABASE ${SOURCE_DB}"
psql -d "${SOURCE_DB}" -q -v ON_ERROR_STOP=1 -f "${FIXTURE}"

echo "==> pg_dump ${SOURCE_DB}"
pg_dump -d "${SOURCE_DB}" -Fc --schema-only -f "${WORKDIR}/source.dump"

echo "==> pull"
./target/debug/pglifecycle pull --dump "${WORKDIR}/source.dump" \
    "${WORKDIR}/project"

echo "==> pull --update from the same dump (no-op gate)"
cp -R "${WORKDIR}/project" "${WORKDIR}/project-before"
./target/debug/pglifecycle pull --update --dump "${WORKDIR}/source.dump" \
    "${WORKDIR}/project"
if ! diff -r "${WORKDIR}/project-before" "${WORKDIR}/project"; then
    echo "Update gate FAILED: pull --update from an unchanged dump" \
        "modified the project" >&2
    exit 1
fi

echo "==> build (loads and validates the pulled project)"
./target/debug/pglifecycle build "${WORKDIR}/project" \
    "${WORKDIR}/build.dump"

echo "==> pg_restore into ${RESTORED_DB}"
bin/drop-database "${RESTORED_DB}"
psql -d postgres -q -c "CREATE DATABASE ${RESTORED_DB}"
pg_restore -d "${RESTORED_DB}" --no-owner --exit-on-error \
    "${WORKDIR}/build.dump"

# The restore above drops every ownership statement, and the schema
# diff below cannot see one either, because ownership is unchanged when
# restoring as the same role. A defect in one was therefore outside
# this gate entirely, which is how the build came to emit
# `ALTER FUNCTION IF EXISTS ... OWNER TO ...` for every function. So
# restore once more with ownership applied; nothing is compared, the
# statements only have to execute.
echo "==> pg_restore into ${OWNED_DB} with ownership applied"
bin/drop-database "${OWNED_DB}"
psql -d postgres -q -c "CREATE DATABASE ${OWNED_DB}"
pg_restore -d "${OWNED_DB}" --exit-on-error "${WORKDIR}/build.dump"

echo "==> Comparing schema-only dumps"
normalize() {
    if [ "${NORMALIZE_BODIES:-0}" = "1" ]; then
        bin/normalize-routine-bodies
    else
        cat
    fi
}
# the \restrict/\unrestrict psql guards carry a random per-dump token
pg_dump -d "${SOURCE_DB}" --schema-only --no-owner \
    | grep -v '^\\\(un\)\{0,1\}restrict ' | normalize \
    > "${WORKDIR}/source.sql"
pg_dump -d "${RESTORED_DB}" --schema-only --no-owner \
    | grep -v '^\\\(un\)\{0,1\}restrict ' | normalize \
    > "${WORKDIR}/restored.sql"
if diff -u "${WORKDIR}/source.sql" "${WORKDIR}/restored.sql"; then
    echo "Round-trip gate passed: schema diff is empty"
else
    echo "Round-trip gate FAILED: schemas differ" >&2
    exit 1
fi

# The settings of the database, and of a role in the database, are not
# in a dump without --create, so the diff above does not see them.
# pg_restore restores the DATABASE PROPERTIES entry only with --create,
# as for an archive of pg_dump, and the entry names the database of
# the project. The build has no DATABASE entry, thus with --create
# pg_restore restores the entry into the database of -d. The step
# removes the settings of the source database, and of postgres in it
# (fixtures/schema.sql sets them), and its connection limit, and
# restores the entry into it. The settings and the connection limit
# that it restores must be the ones that pull read.
echo "==> Database settings: build, restore with --create"
db_settings() {
    psql -d postgres -tA -v ON_ERROR_STOP=1 -c "
        SELECT 'CONNECTION LIMIT', datconnlimit::text
          FROM pg_database
         WHERE datname = '${SOURCE_DB}' AND datconnlimit <> -1
        UNION ALL
        (SELECT setrole::regrole::text, s
          FROM pg_db_role_setting, unnest(setconfig) AS s
         WHERE setdatabase = (SELECT oid FROM pg_database
                               WHERE datname = '${SOURCE_DB}')
         ORDER BY 1, 2)"
}
db_settings > "${WORKDIR}/db-settings-source.txt"
if [ ! -s "${WORKDIR}/db-settings-source.txt" ]; then
    # fixtures/schema.sql has settings; another fixture can have none
    if [ "${FIXTURE}" = fixtures/schema.sql ]; then
        echo "Database settings gate FAILED: the source has no settings" >&2
        exit 1
    fi
    echo "Database settings gate SKIPPED: ${FIXTURE} has no settings"
else
    pg_restore --create -l "${WORKDIR}/build.dump" \
        | grep " DATABASE PROPERTIES " > "${WORKDIR}/db-settings.list" || true
    psql -d postgres -q -v ON_ERROR_STOP=1 \
        -c "ALTER DATABASE ${SOURCE_DB} RESET ALL" \
        -c "ALTER DATABASE ${SOURCE_DB} CONNECTION LIMIT -1" \
        -c "ALTER ROLE postgres IN DATABASE ${SOURCE_DB} RESET ALL"
    pg_restore --create -d "${SOURCE_DB}" --exit-on-error \
        -L "${WORKDIR}/db-settings.list" "${WORKDIR}/build.dump"
    db_settings > "${WORKDIR}/db-settings-restored.txt"
    if diff -u "${WORKDIR}/db-settings-source.txt" \
            "${WORKDIR}/db-settings-restored.txt"; then
        echo "Database settings gate passed: the restored settings are" \
            "the same"
    else
        echo "Database settings gate FAILED: database settings differ" >&2
        exit 1
    fi
fi

# The comment of the database is also not in a dump without --create.
# pg_restore restores the COMMENT entry of the database only with
# --create, and the entry names the database of the project, as the
# DATABASE PROPERTIES entry does. The step removes the comment of the
# source database and restores the entry into it. The comment that it
# restores must be the comment that pull read.
echo "==> Database comment: build, restore with --create"
db_comment() {
    psql -d postgres -tA -v ON_ERROR_STOP=1 -c "
        SELECT shobj_description(oid, 'pg_database')
          FROM pg_database WHERE datname = '${SOURCE_DB}'
           AND shobj_description(oid, 'pg_database') IS NOT NULL"
}
db_comment > "${WORKDIR}/db-comment-source.txt"
if [ ! -s "${WORKDIR}/db-comment-source.txt" ]; then
    # fixtures/schema.sql has a comment; another fixture can have none
    if [ "${FIXTURE}" = fixtures/schema.sql ]; then
        echo "Database comment gate FAILED: the source has no comment" >&2
        exit 1
    fi
    echo "Database comment gate SKIPPED: ${FIXTURE} has no comment"
else
    pg_restore --create -l "${WORKDIR}/build.dump" \
        | grep -E " COMMENT -? DATABASE " > "${WORKDIR}/db-comment.list" \
        || true
    psql -d postgres -q -v ON_ERROR_STOP=1 \
        -c "COMMENT ON DATABASE ${SOURCE_DB} IS NULL"
    pg_restore --create -d "${SOURCE_DB}" --exit-on-error \
        -L "${WORKDIR}/db-comment.list" "${WORKDIR}/build.dump"
    db_comment > "${WORKDIR}/db-comment-restored.txt"
    if diff -u "${WORKDIR}/db-comment-source.txt" \
            "${WORKDIR}/db-comment-restored.txt"; then
        echo "Database comment gate passed: the restored comment is the" \
            "same"
    else
        echo "Database comment gate FAILED: database comments differ" >&2
        exit 1
    fi
fi

# Roles are cluster objects, so pull reads them with pg_dumpall only
# when it connects to a database, and the steps above do not see them.
# A role and a user get settings that need quotes, a list setting with
# one name that has a comma, and a string with a comma for a setting
# that is not a list. The role also gets a comment and a setting with a
# backslash and characters that are not ASCII, which pg_dumpall writes
# as escape strings (E'...'). The comment and a setting have a newline
# and a semicolon, thus pg_dumpall writes each of them on more than one
# line; the second line of the comment starts with a backslash. The
# settings and the comments that the build restores must be the
# settings and the comments that pull read.
# Each name of a list is quoted in pg_db_role_setting, so the
# comparison is exact. The restore applies the owners, as a plain
# pg_restore does.
echo "==> Role settings: pull with pg_dumpall, build, restore"
export PGCLIENTENCODING=UTF8
drop_settings_roles
psql -d postgres -q -v ON_ERROR_STOP=1 <<SQL
CREATE ROLE "${SETTINGS_ROLE}";
COMMENT ON ROLE "${SETTINGS_ROLE}" IS 'rôle C:\x ''q'' ü
\second; line';
ALTER ROLE "${SETTINGS_ROLE}" SET search_path TO "\$user", "my schema", public;
ALTER ROLE "${SETTINGS_ROLE}" SET application_name TO 'x, y';
ALTER ROLE "${SETTINGS_ROLE}" SET enable_seqscan TO off;
ALTER ROLE "${SETTINGS_ROLE}" SET "DateStyle" TO 'iso, mdy';
ALTER ROLE "${SETTINGS_ROLE}" SET roundtrip.path TO 'C:\dossier\é';
ALTER ROLE "${SETTINGS_ROLE}" SET roundtrip.note TO 'one;
two';
CREATE USER "${SETTINGS_USER}";
ALTER ROLE "${SETTINGS_USER}" SET temp_tablespaces TO 'pg_default', 'a,b';
ALTER ROLE "${SETTINGS_USER}" SET search_path TO '';
SQL
role_settings() {
    psql -d postgres -tA -v ON_ERROR_STOP=1 -c "
        SELECT setrole::regrole::text AS role, s
          FROM pg_db_role_setting, unnest(setconfig) AS s
         WHERE setdatabase = 0
           AND setrole::regrole::text IN (
               quote_ident('${SETTINGS_ROLE}'),
               quote_ident('${SETTINGS_USER}'))
         UNION ALL
        SELECT oid::regrole::text,
               'comment: ' || shobj_description(oid, 'pg_authid')
          FROM pg_roles
         WHERE rolname IN ('${SETTINGS_ROLE}', '${SETTINGS_USER}')
           AND shobj_description(oid, 'pg_authid') IS NOT NULL
         ORDER BY 1, 2"
}
role_settings > "${WORKDIR}/role-settings-source.txt"
./target/debug/pglifecycle pull -d "${SOURCE_DB}" "${WORKDIR}/roles"
./target/debug/pglifecycle build "${WORKDIR}/roles" \
    "${WORKDIR}/roles.dump"
pg_restore -l "${WORKDIR}/roles.dump" \
    | grep -E " (ROLE|USER|COMMENT)  (${SETTINGS_ROLE}|${SETTINGS_USER}) " \
    > "${WORKDIR}/roles.list"
drop_settings_roles
pg_restore -d postgres --exit-on-error \
    -L "${WORKDIR}/roles.list" "${WORKDIR}/roles.dump"
role_settings > "${WORKDIR}/role-settings-restored.txt"
if [ ! -s "${WORKDIR}/role-settings-source.txt" ]; then
    echo "Role settings gate FAILED: the roles have no settings" >&2
    exit 1
fi
if diff -u "${WORKDIR}/role-settings-source.txt" \
        "${WORKDIR}/role-settings-restored.txt"; then
    echo "Role settings gate passed: the restored settings are the same"
else
    echo "Role settings gate FAILED: role settings differ" >&2
    exit 1
fi

# A tablespace is a cluster object too, so pull reads it with
# pg_dumpall. Its location must be an empty directory that the server
# can write, on the host of the server. The superuser makes it with
# COPY ... TO PROGRAM, so the step needs no access to the container: it
# works on the compose container and on the service container of CI.
# The directory is in the parent or in the grandparent of the data
# directory, the first that the server can write: in the postgres:18
# image the data directory is /var/lib/postgresql/18/docker, and only
# /var/lib/postgresql is writable. Where the server cannot make the
# directory, the step is skipped. The tablespace has an owner, names
# that need quotes, options, a grant and a comment with a newline. The
# restore applies the owners, as a plain pg_restore does, and the
# tablespace that it makes must be the tablespace that pull read.
echo "==> Tablespace: pull with pg_dumpall, build, restore"
drop_tablespace
make_tablespace_dir() {
    local base
    base="$(psql -d postgres -tAX -v ON_ERROR_STOP=1 \
        -c "SHOW data_directory")"
    for _ in 1 2; do
        base="$(dirname "${base}")"
        TABLESPACE_DIR="${base}/pglifecycle-${NAME}-tablespace"
        if psql -d postgres -q -v ON_ERROR_STOP=1 \
                -v cmd="mkdir -p '${TABLESPACE_DIR}'" \
                <<<"COPY (SELECT 1) TO PROGRAM :'cmd'" \
                2>> "${WORKDIR}/mkdir.log"; then
            return 0
        fi
    done
    return 1
}
if ! make_tablespace_dir; then
    cat "${WORKDIR}/mkdir.log" >&2
    echo "Tablespace gate SKIPPED: the server cannot make a directory" \
        "next to its data directory" >&2
else
    psql -d postgres -q -v ON_ERROR_STOP=1 <<SQL
CREATE ROLE "${TABLESPACE_OWNER}";
CREATE ROLE "${TABLESPACE_USER}";
CREATE TABLESPACE "${TABLESPACE}" OWNER "${TABLESPACE_OWNER}"
    LOCATION '${TABLESPACE_DIR}'
    WITH (random_page_cost = 1.5, effective_io_concurrency = 20);
COMMENT ON TABLESPACE "${TABLESPACE}" IS 'it''s fast
\\second; line';
GRANT CREATE ON TABLESPACE "${TABLESPACE}" TO "${TABLESPACE_USER}";
SQL
    tablespace() {
        psql -d postgres -tA -v ON_ERROR_STOP=1 -c "
            SELECT spcname, spcowner::regrole,
                   pg_tablespace_location(oid), spcoptions, spcacl,
                   shobj_description(oid, 'pg_tablespace')
              FROM pg_tablespace
             WHERE spcname = '${TABLESPACE}'"
    }
    tablespace > "${WORKDIR}/tablespace-source.txt"
    ./target/debug/pglifecycle pull -d "${SOURCE_DB}" \
        "${WORKDIR}/tablespace"
    ./target/debug/pglifecycle build "${WORKDIR}/tablespace" \
        "${WORKDIR}/tablespace.dump"
    # the entries of the two roles, and of the tablespace, its comment
    # and its grant, in the order of the archive
    pg_restore -l "${WORKDIR}/tablespace.dump" \
        | grep -E " (ROLE  (${TABLESPACE_OWNER}|${TABLESPACE_USER})|(TABLESPACE|COMMENT)  ${TABLESPACE}|ACL  TABLESPACE ${TABLESPACE}) " \
        > "${WORKDIR}/tablespace.list" || true
    drop_tablespace
    pg_restore -d postgres --exit-on-error \
        -L "${WORKDIR}/tablespace.list" "${WORKDIR}/tablespace.dump"
    tablespace > "${WORKDIR}/tablespace-restored.txt"
    if [ ! -s "${WORKDIR}/tablespace-source.txt" ]; then
        echo "Tablespace gate FAILED: the source has no tablespace" >&2
        exit 1
    fi
    if diff -u "${WORKDIR}/tablespace-source.txt" \
            "${WORKDIR}/tablespace-restored.txt"; then
        echo "Tablespace gate passed: the restored tablespace is the same"
    else
        echo "Tablespace gate FAILED: the tablespaces differ" >&2
        exit 1
    fi
    drop_tablespace
fi

# A role, a user and a group of a project own a schema and a table, are
# in a policy, get grants and have default privileges. pg_restore runs
# the entries in the order of the archive, so each role must come
# before the first entry that names it. The restore makes the roles
# and applies the owners, as a plain pg_restore does, into an empty
# database.
echo "==> Project roles: build, restore with owners into an empty database"
mkdir -p "${WORKDIR}/roles-project/"{roles,users,groups,schemata,tables/app}
mkdir -p "${WORKDIR}/roles-project/default_privileges"
printf -- '---\nname: roles\nsuperuser: %s\n' "${PGUSER}" \
    > "${WORKDIR}/roles-project/project.yaml"
printf -- '---\nname: %s\n' "${ROLES_OWNER}" \
    > "${WORKDIR}/roles-project/roles/owner.yaml"
printf -- '---\nname: %s\n' "${ROLES_GROUP}" \
    > "${WORKDIR}/roles-project/groups/readers.yaml"
cat > "${WORKDIR}/roles-project/users/reader.yaml" <<YAML
---
name: ${ROLES_USER}
grants:
  schemata:
    app:
      - USAGE
  tables:
    app.things:
      - SELECT
YAML
cat > "${WORKDIR}/roles-project/schemata/app.yaml" <<YAML
---
name: app
owner: ${ROLES_OWNER}
YAML
cat > "${WORKDIR}/roles-project/tables/app/things.yaml" <<YAML
---
schema: app
name: things
owner: ${ROLES_OWNER}
columns:
  - name: id
    data_type: integer
row_level_security:
  enabled: true
policies:
  - name: readers
    command: SELECT
    roles:
      - ${ROLES_GROUP}
    using: 'true'
YAML
cat > "${WORKDIR}/roles-project/default_privileges/owner.yaml" <<YAML
---
name: ${ROLES_OWNER}
grants:
  - object_type: TABLES
    grantee: ${ROLES_USER}
    privileges:
      - SELECT
YAML
./target/debug/pglifecycle build "${WORKDIR}/roles-project" \
    "${WORKDIR}/roles.project.dump"
bin/drop-database "${ROLES_DB}"
drop_project_roles
psql -d postgres -q -c "CREATE DATABASE ${ROLES_DB}"
pg_restore -d "${ROLES_DB}" --exit-on-error "${WORKDIR}/roles.project.dump"
owners="$(psql -d "${ROLES_DB}" -tAX -v ON_ERROR_STOP=1 -c "
    SELECT (SELECT nspowner::regrole FROM pg_namespace
             WHERE nspname = 'app')
           || ' ' || 'app.things'::regclass::text || ' '
           || (SELECT relowner::regrole FROM pg_class
                WHERE oid = 'app.things'::regclass)")"
expected="\"${ROLES_OWNER}\" app.things \"${ROLES_OWNER}\""
if [ "${owners}" != "${expected}" ]; then
    echo "Project roles gate FAILED: the owners are '${owners}'," \
        "not '${expected}'" >&2
    exit 1
fi
echo "Project roles gate passed: the roles own their objects"
bin/drop-database "${ROLES_DB}"
drop_project_roles

# The text of a project is UTF-8, so the build writes the archive in
# UTF8 and pg_restore converts the text to the encoding of the
# database. A project that sets another encoding, or that sets
# stdstrings to false, is refused: the build cannot write that archive.
# The text must be the same in a LATIN1 and in a UTF8 database. All the
# characters are in LATIN1.
echo "==> Build encoding: restore into a LATIN1 and a UTF8 database"
ENC_TEXT='rôle ü é C:\x'
mkdir -p "${WORKDIR}/enc/schemata"
cat > "${WORKDIR}/enc/schemata/enc.yaml" <<YAML
---
name: enc
owner: postgres
comment: '${ENC_TEXT}'
YAML
for setting in 'encoding: LATIN1' 'stdstrings: false'; do
    printf -- '---\nname: enc\nsuperuser: postgres\n%s\n' "${setting}" \
        > "${WORKDIR}/enc/project.yaml"
    if ./target/debug/pglifecycle build "${WORKDIR}/enc" \
            "${WORKDIR}/enc.dump" 2> "${WORKDIR}/enc.log"; then
        echo "Build encoding gate FAILED: build accepted ${setting}" >&2
        exit 1
    fi
    if ! grep -q "${setting%%:*}" "${WORKDIR}/enc.log"; then
        cat "${WORKDIR}/enc.log" >&2
        echo "Build encoding gate FAILED: the error for ${setting}" \
            "does not name the field" >&2
        exit 1
    fi
done
printf -- '---\nname: enc\nsuperuser: postgres\n' \
    > "${WORKDIR}/enc/project.yaml"
./target/debug/pglifecycle build "${WORKDIR}/enc" "${WORKDIR}/enc.dump"
for encoding in LATIN1 UTF8; do
    db="${ENC_DB_PREFIX}_$(echo "${encoding}" | tr '[:upper:]' '[:lower:]')"
    bin/drop-database "${db}"
    psql -d postgres -q -v ON_ERROR_STOP=1 -c "CREATE DATABASE ${db} \
        ENCODING '${encoding}' LOCALE 'C' TEMPLATE template0"
    pg_restore -d "${db}" --exit-on-error "${WORKDIR}/enc.dump"
    text="$(psql -d "${db}" -tA -v ON_ERROR_STOP=1 \
        -c "SELECT obj_description('enc'::regnamespace, 'pg_namespace')")"
    if [ "${text}" != "${ENC_TEXT}" ]; then
        echo "Build encoding gate FAILED: the ${encoding} database has" \
            "the comment '${text}', not '${ENC_TEXT}'" >&2
        exit 1
    fi
    echo "Build encoding gate passed: the ${encoding} database has the text"
done
