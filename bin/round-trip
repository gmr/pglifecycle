#!/usr/bin/env bash
# Round-trip gate:
#
#   bin/round-trip [FIXTURE [NAME]]
#
#   FIXTURE -> PostgreSQL -> pg_dump -Fc -> pull ->
#   load + validate -> build -> pg_restore -> pg_dump --schema-only
#   of both databases -> diff is empty
#
# Plus a second restore with ownership applied, which the comparing
# restore cannot check because it runs --no-owner.
#
# Requires a PostgreSQL superuser connection (defaults target the
# compose.yaml container; override with PGHOST/PGPORT/PGUSER) and the
# postgres client tools on PATH. All commands run via psql/pg_dump
# against scratch databases, named NAME_source, NAME_restored and
# NAME_owned, that are dropped and recreated. FIXTURE defaults to
# fixtures/schema.sql and NAME to roundtrip.
#
# pull formats routine bodies, so a fixture that is not written in the
# formatter's style dumps its bodies differently after the round trip.
# NORMALIZE_BODIES=1 compares the bodies with whitespace and semicolons
# removed (bin/normalize-routine-bodies); everything else is compared
# exactly. fixtures/schema.sql is written in that style and needs no
# normalizing.
set -euo pipefail

FIXTURE="${1:-fixtures/schema.sql}"
NAME="${2:-roundtrip}"

PGHOST="${PGHOST:-localhost}"
PGPORT="${PGPORT:-5432}"
PGUSER="${PGUSER:-postgres}"
export PGHOST PGPORT PGUSER

SOURCE_DB="${NAME}_source"
RESTORED_DB="${NAME}_restored"
OWNED_DB="${NAME}_owned"
WORKDIR="$(mktemp -d)"

cleanup() {
    rm -rf "$WORKDIR"
    psql -d postgres -q -c "DROP DATABASE IF EXISTS ${RESTORED_DB}" \
        >/dev/null 2>&1 || true
    psql -d postgres -q -c "DROP DATABASE IF EXISTS ${OWNED_DB}" \
        >/dev/null 2>&1 || true
    psql -d postgres -q -c "DROP DATABASE IF EXISTS ${SOURCE_DB}" \
        >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

echo "==> Building pglifecycle"
cargo build --quiet

echo "==> Creating ${SOURCE_DB} from ${FIXTURE}"
psql -d postgres -q -c "DROP DATABASE IF EXISTS ${SOURCE_DB}"
psql -d postgres -q -c "CREATE DATABASE ${SOURCE_DB}"
psql -d "${SOURCE_DB}" -q -v ON_ERROR_STOP=1 -f "${FIXTURE}"

echo "==> pg_dump ${SOURCE_DB}"
pg_dump -d "${SOURCE_DB}" -Fc --schema-only -f "${WORKDIR}/source.dump"

echo "==> pull"
./target/debug/pglifecycle pull --dump "${WORKDIR}/source.dump" \
    "${WORKDIR}/project"

echo "==> pull --update from the same dump (no-op gate)"
cp -R "${WORKDIR}/project" "${WORKDIR}/project-before"
./target/debug/pglifecycle pull --update --dump "${WORKDIR}/source.dump" \
    "${WORKDIR}/project"
if ! diff -r "${WORKDIR}/project-before" "${WORKDIR}/project"; then
    echo "Update gate FAILED: pull --update from an unchanged dump" \
        "modified the project" >&2
    exit 1
fi

echo "==> build (loads and validates the pulled project)"
./target/debug/pglifecycle build "${WORKDIR}/project" \
    "${WORKDIR}/build.dump"

echo "==> pg_restore into ${RESTORED_DB}"
psql -d postgres -q -c "DROP DATABASE IF EXISTS ${RESTORED_DB}"
psql -d postgres -q -c "CREATE DATABASE ${RESTORED_DB}"
pg_restore -d "${RESTORED_DB}" --no-owner --exit-on-error \
    "${WORKDIR}/build.dump"

# The restore above drops every ownership statement, and the schema
# diff below cannot see one either, because ownership is unchanged when
# restoring as the same role. A defect in one was therefore outside
# this gate entirely, which is how the build came to emit
# `ALTER FUNCTION IF EXISTS ... OWNER TO ...` for every function. So
# restore once more with ownership applied; nothing is compared, the
# statements only have to execute.
echo "==> pg_restore into ${OWNED_DB} with ownership applied"
psql -d postgres -q -c "DROP DATABASE IF EXISTS ${OWNED_DB}"
psql -d postgres -q -c "CREATE DATABASE ${OWNED_DB}"
pg_restore -d "${OWNED_DB}" --exit-on-error "${WORKDIR}/build.dump"

echo "==> Comparing schema-only dumps"
normalize() {
    if [ "${NORMALIZE_BODIES:-0}" = "1" ]; then
        bin/normalize-routine-bodies
    else
        cat
    fi
}
# the \restrict/\unrestrict psql guards carry a random per-dump token
pg_dump -d "${SOURCE_DB}" --schema-only --no-owner \
    | grep -v '^\\\(un\)\{0,1\}restrict ' | normalize \
    > "${WORKDIR}/source.sql"
pg_dump -d "${RESTORED_DB}" --schema-only --no-owner \
    | grep -v '^\\\(un\)\{0,1\}restrict ' | normalize \
    > "${WORKDIR}/restored.sql"
if diff -u "${WORKDIR}/source.sql" "${WORKDIR}/restored.sql"; then
    echo "Round-trip gate passed: schema diff is empty"
else
    echo "Round-trip gate FAILED: schemas differ" >&2
    exit 1
fi
