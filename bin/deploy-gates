#!/usr/bin/env bash
# Deploy gates:
#
#   1. Equivalence — deploy --apply against an empty database yields the
#      same schema as build + pg_restore (schema-only dumps match), for
#      fixtures/schema.sql and for the pagila schema, whose re-deploy is
#      also an empty plan.
#   2. Convergence — mutate the database; without --allow-drop every
#      destructive change is withheld and reported, and with it
#      deploy --apply converges, so a re-deploy produces an empty plan.
#   3. Safety — without --allow-drop the script has no destructive
#      statements and --apply refuses while drops are pending.
#
# Requires a PostgreSQL superuser connection (defaults target the
# compose.yaml container; override with PGHOST/PGPORT/PGUSER) and the
# postgres client tools on PATH.
set -euo pipefail

PGHOST="${PGHOST:-localhost}"
PGPORT="${PGPORT:-5432}"
PGUSER="${PGUSER:-postgres}"
export PGHOST PGPORT PGUSER

SOURCE_DB=deploy_source
TARGET_DB=deploy_target
PAGILA_SOURCE_DB=deploy_pagila_source
PAGILA_TARGET_DB=deploy_pagila_target
WORKDIR="$(mktemp -d)"

cleanup() {
    rm -rf "$WORKDIR"
    bin/drop-database "${TARGET_DB}" \
        >/dev/null 2>&1 || true
    bin/drop-database "${SOURCE_DB}" \
        >/dev/null 2>&1 || true
    bin/drop-database "${PAGILA_TARGET_DB}" \
        >/dev/null 2>&1 || true
    bin/drop-database "${PAGILA_SOURCE_DB}" \
        >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# Schema-only dump with the per-dump \restrict token stripped
dump_schema() {
    pg_dump -d "$1" --schema-only --no-owner \
        | grep -v '^\\\(un\)\{0,1\}restrict '
}

# Plan the project against the target and require an empty plan; $1
# says what the step checks
expect_empty_plan() {
    ./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
        -d "${TARGET_DB}" "${WORKDIR}/project"
    if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
        echo "Convergence gate passed: $1"
    else
        echo "Convergence gate FAILED: $1" >&2
        cat "${WORKDIR}/replan.sql" >&2
        exit 1
    fi
}

echo "==> Building pglifecycle"
cargo build --quiet

echo "==> Creating ${SOURCE_DB} from fixtures/schema.sql"
bin/drop-database "${SOURCE_DB}"
psql -d postgres -q -c "CREATE DATABASE ${SOURCE_DB}"
psql -d "${SOURCE_DB}" -q -v ON_ERROR_STOP=1 -f fixtures/schema.sql
# a comment-less view (dependency-free so it needs no ordering): the
# project carries no comment, so a database-only comment must be
# cleared during convergence (gate 2)
psql -d "${SOURCE_DB}" -q -v ON_ERROR_STOP=1 \
    -c "CREATE VIEW test.deploy_probe AS SELECT 1 AS n;"

echo "==> pull a project from ${SOURCE_DB}"
pg_dump -d "${SOURCE_DB}" -Fc --schema-only -f "${WORKDIR}/source.dump"
./target/debug/pglifecycle pull --dump "${WORKDIR}/source.dump" \
    "${WORKDIR}/project"

echo "==> Gate 1: equivalence (deploy --apply into an empty database)"
bin/drop-database "${TARGET_DB}"
psql -d postgres -q -c "CREATE DATABASE ${TARGET_DB}"
./target/debug/pglifecycle deploy --apply -d "${TARGET_DB}" \
    "${WORKDIR}/project"
dump_schema "${SOURCE_DB}" > "${WORKDIR}/source.sql"
dump_schema "${TARGET_DB}" > "${WORKDIR}/target.sql"
if diff -u "${WORKDIR}/source.sql" "${WORKDIR}/target.sql"; then
    echo "Equivalence gate passed: schema diff is empty"
else
    echo "Equivalence gate FAILED: deployed schema differs from source" >&2
    exit 1
fi

echo "==> Gate 1: equivalence of pagila (deploy --apply into an empty database)"
# a schema that someone else wrote (fixtures/pagila/README.md). Some of
# its LANGUAGE sql functions refer, by a name with no schema, to a
# table that the script makes after them, so the script must not check
# function bodies, as pg_restore does not. The routine bodies of
# pagila are not in the style that pull writes, so the diff compares
# them without whitespace and semicolons (bin/normalize-routine-bodies).
bin/drop-database "${PAGILA_SOURCE_DB}"
psql -d postgres -q -c "CREATE DATABASE ${PAGILA_SOURCE_DB}"
psql -d "${PAGILA_SOURCE_DB}" -q -v ON_ERROR_STOP=1 \
    -f fixtures/pagila/pagila-schema.sql
pg_dump -d "${PAGILA_SOURCE_DB}" -Fc --schema-only \
    -f "${WORKDIR}/pagila.dump"
./target/debug/pglifecycle pull --dump "${WORKDIR}/pagila.dump" \
    "${WORKDIR}/pagila"
bin/drop-database "${PAGILA_TARGET_DB}"
psql -d postgres -q -c "CREATE DATABASE ${PAGILA_TARGET_DB}"
./target/debug/pglifecycle deploy --apply -d "${PAGILA_TARGET_DB}" \
    "${WORKDIR}/pagila"
./target/debug/pglifecycle deploy -o "${WORKDIR}/pagila-replan.sql" \
    -d "${PAGILA_TARGET_DB}" "${WORKDIR}/pagila"
if ! grep -q '^-- no changes' "${WORKDIR}/pagila-replan.sql"; then
    echo "Equivalence gate FAILED: the pagila re-deploy is not empty" >&2
    cat "${WORKDIR}/pagila-replan.sql" >&2
    exit 1
fi
dump_schema "${PAGILA_SOURCE_DB}" | bin/normalize-routine-bodies \
    > "${WORKDIR}/pagila-source.sql"
dump_schema "${PAGILA_TARGET_DB}" | bin/normalize-routine-bodies \
    > "${WORKDIR}/pagila-target.sql"
if diff -u "${WORKDIR}/pagila-source.sql" "${WORKDIR}/pagila-target.sql"
then
    echo "Equivalence gate passed: pagila schema diff and re-deploy are" \
        "empty"
else
    echo "Equivalence gate FAILED: deployed pagila schema differs from" \
        "source" >&2
    exit 1
fi

echo "==> Gate 2: convergence (mutate, deploy --apply, re-deploy is empty)"
# exercise a column add (gated drop), a nullability flip (in place),
# a domain default (in-place ALTER DOMAIN), and a database-only comment
# on an OR REPLACE object (must be cleared with COMMENT ... IS NULL so
# the re-deploy converges)
# the foreign-object drift (wrapper, server, and foreign-table options)
# must reconcile in place via the deploy ALTER renderers
# users.id is a primary-key column, so its renamed NOT NULL constraint
# has to converge through RENAME CONSTRAINT: PostgreSQL rejects DROP
# NOT NULL there outright
# row-security drift: turned off and unforced, one policy dropped, one
# edited, one database-only, and a changed policy comment
# replica identity reset and changed, an exclusion constraint's comment
# changed, and another one dropped; column storage, compression,
# statistics target and options changed; constraint comments changed
# and cleared, and a commented check replaced by a different one, whose
# comment deploy has to set again after re-adding it; rules
# re-enabled, dropped, commented and replaced, on a table and a view;
# a partitioned table's index made again with another definition, as
# are its partitions' indexes, so deploy has to drop the group and
# make and attach it again; and a comment on an attached partition
# index, which deploy has to change in place, because PostgreSQL does
# not drop an attached index; and changes to columns whose names need
# quoting, and to the trigger, foreign key and index that name them
psql -d "${TARGET_DB}" -q -v ON_ERROR_STOP=1 <<'SQL'
ALTER TABLE test.users ADD COLUMN scratch text;
ALTER TABLE test.users ALTER COLUMN display_name SET NOT NULL;
ALTER TABLE test.users
    RENAME CONSTRAINT users_id_not_null TO users_id_nn_drift;
ALTER DOMAIN test.bcp47_locale SET DEFAULT 'en-US';
COMMENT ON VIEW test.deploy_probe IS 'stale, not in repo';
ALTER FOREIGN DATA WRAPPER gate_fdw OPTIONS (SET debug 'false');
ALTER SERVER gate_srv OPTIONS (SET host 'changed', DROP dbname);
ALTER FOREIGN TABLE test.gate_ft OPTIONS (SET table_name 'changed');
ALTER TABLE test.tenant_notes DISABLE ROW LEVEL SECURITY;
ALTER TABLE test.tenant_notes NO FORCE ROW LEVEL SECURITY;
DROP POLICY tenant_notes_read ON test.tenant_notes;
ALTER POLICY tenant_notes_own ON test.tenant_notes USING (true);
CREATE POLICY stray ON test.tenant_notes AS RESTRICTIVE USING (true);
COMMENT ON POLICY tenant_notes_own ON test.tenant_notes IS 'drift';
ALTER TABLE test.sealed_notes DISABLE ROW LEVEL SECURITY;
ALTER TABLE test.replica_full REPLICA IDENTITY DEFAULT;
ALTER TABLE test.replica_index REPLICA IDENTITY FULL;
COMMENT ON CONSTRAINT room_bookings_no_overlap ON test.room_bookings
    IS 'drift';
ALTER TABLE test.handles DROP CONSTRAINT handles_unique_lower;
ALTER TABLE test.documents ALTER COLUMN body SET STORAGE EXTENDED;
ALTER TABLE test.documents ALTER COLUMN body SET COMPRESSION pglz;
ALTER TABLE test.documents ALTER COLUMN id SET STATISTICS 100;
ALTER TABLE test.documents ALTER COLUMN size RESET (n_distinct);
COMMENT ON CONSTRAINT invoices_pkey ON test.invoices IS 'drift';
COMMENT ON CONSTRAINT invoices_number_key ON test.invoices IS NULL;
ALTER TABLE test.invoices DROP CONSTRAINT invoices_total_positive;
ALTER TABLE test.invoices ADD CONSTRAINT invoices_total_positive
    CHECK (total > 0);
ALTER TABLE test.ledger ENABLE RULE ledger_redirect;
DROP RULE ledger_no_delete ON test.ledger;
COMMENT ON RULE ledger_audit_insert ON test.ledger IS 'drift';
CREATE OR REPLACE RULE ledger_view_insert AS ON INSERT TO test.ledger_view
    DO INSTEAD NOTHING;
DROP INDEX test.readings_taken;
CREATE INDEX readings_taken ON ONLY test.readings (taken DESC);
CREATE INDEX readings_2020_by_day ON test.readings_2020 (taken DESC);
ALTER INDEX test.readings_taken ATTACH PARTITION test.readings_2020_by_day;
CREATE INDEX readings_2021_by_day ON test.readings_2021 (taken DESC);
ALTER INDEX test.readings_taken ATTACH PARTITION test.readings_2021_by_day;
COMMENT ON INDEX test.readings_2021_id_idx IS 'drift';
ALTER TABLE test.revocations ALTER COLUMN revoked
    SET EXPRESSION AS (revoked_at IS NULL);
CREATE FUNCTION test."Stray Fn"("Arg" INTEGER) RETURNS INTEGER
    LANGUAGE sql AS 'SELECT 1';
ALTER TABLE test.quoted_cols ALTER COLUMN "Name" DROP DEFAULT;
ALTER TABLE test.quoted_cols ALTER COLUMN "Name" DROP NOT NULL;
ALTER TABLE test.quoted_cols ALTER COLUMN "Has Space" SET STATISTICS 50;
COMMENT ON COLUMN test.quoted_cols."Name" IS 'drift';
ALTER TABLE test.quoted_cols ADD COLUMN "Stray Col" INTEGER;
DROP TRIGGER quoted_cols_touch ON test.quoted_cols;
ALTER TABLE test.quoted_refs DROP CONSTRAINT quoted_refs_ref;
DROP INDEX test.quoted_cols_name;
SQL
# every destructive change is run twice: first withheld and reported,
# then applied with --allow-drop
./target/debug/pglifecycle deploy -o "${WORKDIR}/withheld.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
./target/debug/pglifecycle deploy --allow-drop -o "${WORKDIR}/allowed.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
withheld="$(sed -n 's/^-- destructive statements: \([0-9]*\) excluded.*/\1/p' \
    "${WORKDIR}/withheld.sql")"
allowed="$(sed -n 's/^-- destructive statements: \([0-9]*\) included$/\1/p' \
    "${WORKDIR}/allowed.sql")"
if [ -z "${withheld}" ] || [ "${withheld}" != "${allowed}" ]; then
    echo "Convergence gate FAILED: ${withheld:-no} statement(s) withheld" \
        "without --allow-drop, ${allowed:-no} included with it" >&2
    exit 1
fi
# an index drop loses no data, so deploy does not withhold it
if grep -v '^DROP INDEX ' "${WORKDIR}/withheld.sql" \
        | grep -Eq '^(DROP |ALTER TABLE .* DROP COLUMN)'
then
    echo "Convergence gate FAILED: destructive statement in the script" \
        "without --allow-drop" >&2
    cat "${WORKDIR}/withheld.sql" >&2
    exit 1
fi
./target/debug/pglifecycle deploy --apply --allow-drop -d "${TARGET_DB}" \
    "${WORKDIR}/project"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: re-deploy is an empty plan"
else
    echo "Convergence gate FAILED: re-deploy is not empty" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# an index expression written with the parentheses that enclose all
# of it, as CREATE INDEX needs for a cast: deploy compares it without
# them, so the plan stays empty
perl -pi -e 's/expression: \(label\)::character varying\(20\)$/expression: ((label)::character varying(20))/' \
    "${WORKDIR}/project/tables/test/measurements.yaml"
grep -q 'expression: ((label)' "${WORKDIR}/project/tables/test/measurements.yaml"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: an enclosed index expression is unchanged"
else
    echo "Convergence gate FAILED: an enclosed index expression changed" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# the short forms a project can use: a primary key as one column name,
# an integer default as a number, and a foreign key with no name, which
# gets the name PostgreSQL generates. Each loads as pull writes it, so
# the plan stays empty
perl -0pi -e 's/primary_key:\n- id\n/primary_key: id\n/; s/- name: addresses_user_id_fkey\n  columns:/- columns:/' \
    "${WORKDIR}/project/tables/test/addresses.yaml"
perl -pi -e "s/default: '0'\$/default: 0/" \
    "${WORKDIR}/project/tables/test/tenant_files.yaml"
grep -q '^primary_key: id$' "${WORKDIR}/project/tables/test/addresses.yaml"
! grep -q 'addresses_user_id_fkey' \
    "${WORKDIR}/project/tables/test/addresses.yaml"
grep -q 'default: 0$' "${WORKDIR}/project/tables/test/tenant_files.yaml"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: short forms are unchanged"
else
    echo "Convergence gate FAILED: short forms changed" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# type names written in uppercase, as a style guide can require:
# PostgreSQL folds them to lowercase, so the plan stays empty
find "${WORKDIR}/project/tables" -name '*.yaml' -exec perl -pi -e \
    's/^(\s*data_type: )(text|integer|bigint|boolean)$/$1\U$2/' {} +
if ! grep -rqE 'data_type: (TEXT|INTEGER)$' "${WORKDIR}/project/tables"; then
    echo "Convergence gate FAILED: no type was changed to uppercase" >&2
    exit 1
fi
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: uppercase type names are unchanged"
else
    echo "Convergence gate FAILED: uppercase type names changed" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# a generated column written without the parentheses and the kind that
# pull writes: deploy compares the expression without them, and reads
# no kind as stored, so the plan stays empty
perl -0pi -e 's/(- name: revoked\n  data_type: (?i:boolean)\n  generated:\n    expression: )\(revoked_at IS NOT NULL\)\n    kind: stored\n/$1revoked_at IS NOT NULL\n/' \
    "${WORKDIR}/project/tables/test/revocations.yaml"
grep -q 'expression: revoked_at IS NOT NULL$' \
    "${WORKDIR}/project/tables/test/revocations.yaml"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: a generated column's short form is unchanged"
else
    echo "Convergence gate FAILED: a generated column's short form changed" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# a renamed partition index whose partitioned table has no other
# change: deploy has to rebuild the group from the partitioned table,
# because PostgreSQL does not attach a second index for the same parent
psql -d "${TARGET_DB}" -q -v ON_ERROR_STOP=1 \
    -c "ALTER INDEX test.readings_2020_id_idx RENAME TO readings_2020_id_drift;"
./target/debug/pglifecycle deploy --apply --allow-drop -d "${TARGET_DB}" \
    "${WORKDIR}/project"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate passed: partition index group rebuilt"
else
    echo "Convergence gate FAILED: partition index group not rebuilt" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
# an index made at runtime, which the project does not have: deploy
# keeps it without --allow-drop-indexes, even with --allow-drop, and
# --apply runs with it kept; with the flag, deploy drops it
psql -d "${TARGET_DB}" -q -v ON_ERROR_STOP=1 \
    -c "CREATE INDEX runtime_users_id ON test.users (id);"
./target/debug/pglifecycle deploy --apply --allow-drop -d "${TARGET_DB}" \
    "${WORKDIR}/project"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
runtime_index="SELECT count(*) FROM pg_indexes
    WHERE schemaname = 'test' AND indexname = 'runtime_users_id'"
if [ "$(psql -d "${TARGET_DB}" -tAc "${runtime_index}")" != 1 ] \
    || ! grep -q '^-- indexes kept: 1 ' "${WORKDIR}/replan.sql" \
    || ! grep -q '^-- no changes' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate FAILED: runtime index not kept" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
./target/debug/pglifecycle deploy --apply --allow-drop-indexes \
    -d "${TARGET_DB}" "${WORKDIR}/project"
./target/debug/pglifecycle deploy -o "${WORKDIR}/replan.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if [ "$(psql -d "${TARGET_DB}" -tAc "${runtime_index}")" != 0 ] \
    || grep -q '^-- indexes kept' "${WORKDIR}/replan.sql"; then
    echo "Convergence gate FAILED: runtime index not dropped with" \
        "--allow-drop-indexes" >&2
    cat "${WORKDIR}/replan.sql" >&2
    exit 1
fi
echo "Convergence gate passed: runtime index kept, and dropped with" \
    "--allow-drop-indexes"
# the convergence steps for each object type, one file each, so that
# work on separate types does not change the same lines. Each step
# starts and ends with the target converged to the project
for step in bin/deploy-gates.d/*.sh; do
    echo "==> Gate 2 step: ${step##*/}"
    # shellcheck source=/dev/null
    source "${step}"
done

echo "==> Gate 3: safety (drops gated without --allow-drop)"
psql -d "${TARGET_DB}" -q -v ON_ERROR_STOP=1 \
    -c "ALTER TABLE test.users ADD COLUMN scratch text;"
./target/debug/pglifecycle deploy -o "${WORKDIR}/gated.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if grep -Eq 'DROP TABLE|DROP COLUMN|ALTER COLUMN .* TYPE' \
        "${WORKDIR}/gated.sql"; then
    echo "Safety gate FAILED: destructive statement in the script" >&2
    cat "${WORKDIR}/gated.sql" >&2
    exit 1
fi
APPLY_ERR="${WORKDIR}/apply.err"
if ./target/debug/pglifecycle deploy --apply -d "${TARGET_DB}" \
        "${WORKDIR}/project" > /dev/null 2>"${APPLY_ERR}"; then
    echo "Safety gate FAILED: --apply did not refuse pending drops" >&2
    exit 1
fi
if ! grep -q "destructive statement(s) are pending" "${APPLY_ERR}"; then
    echo "Safety gate FAILED: --apply failed for an unexpected reason" >&2
    cat "${APPLY_ERR}" >&2
    exit 1
fi
# a policy edit is gated, and withholding it leaves the old, possibly
# wider policy in place, so the script must name it rather than stay
# silent; turning row security off is gated too
psql -d "${TARGET_DB}" -q -v ON_ERROR_STOP=1 \
    -c "ALTER POLICY tenant_notes_own ON test.tenant_notes USING (true);" \
    -c "ALTER TABLE test.sealed_notes DISABLE ROW LEVEL SECURITY;"
./target/debug/pglifecycle deploy -o "${WORKDIR}/gated.sql" \
    -d "${TARGET_DB}" "${WORKDIR}/project"
if ! grep -q '^-- WARNING: POLICY test.tenant_notes tenant_notes_own' \
        "${WORKDIR}/gated.sql"; then
    echo "Safety gate FAILED: no warning for a withheld policy" >&2
    cat "${WORKDIR}/gated.sql" >&2
    exit 1
fi
if grep -q 'DROP POLICY' "${WORKDIR}/gated.sql"; then
    echo "Safety gate FAILED: gated policy change in the script" >&2
    cat "${WORKDIR}/gated.sql" >&2
    exit 1
fi
if ! grep -q 'sealed_notes ENABLE ROW LEVEL SECURITY' \
        "${WORKDIR}/gated.sql"; then
    echo "Safety gate FAILED: ENABLE ROW LEVEL SECURITY was withheld" >&2
    cat "${WORKDIR}/gated.sql" >&2
    exit 1
fi
echo "Safety gate passed: drops excluded and --apply refused"

echo "All deploy gates passed"
